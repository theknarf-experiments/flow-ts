{
  "name": "flow-ts",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/parsing/__generated__",
    "bench": "vitest run --config vitest.bench.config.ts",
    "build:grammar": "peggy src/parsing/grammar.peggy --format es -o src/parsing/__generated__/grammar.js --dts"
  },
  "dependencies": {
    "@flow-ts/db-ivm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^4.8.0",
    "peggy": "^4.2.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
