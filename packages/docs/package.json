{
  "name": "@flow-ts/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-node --script ./ssg.tsx",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:ui": "playwright test --ui",
    "clean": "rm -rf dist .vite test-results",
    "build:spa": "vite build"
  },
  "dependencies": {
    "@flow-ts/parsing": "workspace:*",
    "@flow-ts/react": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "flow-ts": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0"
  }
}
