{
  "name": "flow-ts",
  "version": "0.1.0",
  "description": "A Datalog engine in TypeScript, built on incremental dataflow \u2014 parse, stratify and plan programs, then feed facts in over time and only the affected derivations re-run.",
  "keywords": [
    "datalog",
    "incremental",
    "dataflow",
    "ivm",
    "incremental-view-maintenance",
    "query-engine",
    "logic-programming",
    "recursion",
    "stratification",
    "typescript"
  ],
  "license": "MIT",
  "author": "Frank Lyder Bredland",
  "homepage": "https://github.com/theknarf-experiments/flow-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theknarf-experiments/flow-ts.git",
    "directory": "packages/flow-ts"
  },
  "bugs": "https://github.com/theknarf-experiments/flow-ts/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/parsing/__generated__",
    "bench": "vitest run --config vitest.bench.config.ts",
    "build:grammar": "peggy src/parsing/grammar.peggy --format es -o src/parsing/__generated__/grammar.js --dts"
  },
  "dependencies": {
    "fractional-indexing": "^3.2.0",
    "sorted-btree": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^4.8.0",
    "peggy": "^4.2.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
