{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build:grammar": {
      "inputs": ["src/parsing/grammar.peggy"],
      "outputs": ["src/parsing/__generated__/**"]
    },
    "build": {
      "dependsOn": ["^build", "build:grammar"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build:grammar"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build:grammar"],
      "inputs": [
        "src/**",
        "tests/**",
        "e2e/**",
        "tsconfig.json",
        "package.json",
        "vitest.config.ts",
        "playwright.config.ts",
        "index.html",
        "vite.config.ts",
        "ssg.tsx",
        "ssg-for-vite.tsx"
      ],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["^build", "build:grammar"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
